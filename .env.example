# Passcode for the admin submissions view at /#admin
#
# IMPORTANT: Create React App inlines REACT_APP_* variables into the JavaScript
# bundle at build time. This value is therefore PUBLIC -- it is visible to anyone
# who opens DevTools on the deployed site. It changes who will casually stumble
# into the admin view; it is not a secret and is not access control.
#
# Never put a real credential in a REACT_APP_* variable.
REACT_APP_ADMIN_PASSCODE=hpair-admin
