# Copy to .env.local for local development, and set the same values in
# Vercel → Project → Settings → Environment Variables for the deployed site.

# --- Supabase -------------------------------------------------------------
#
# Both values are PUBLIC. Create React App inlines REACT_APP_* variables into the
# JavaScript bundle at build time, and the anon key is designed to ship to
# browsers -- it identifies the project, it does not authorise anything.
#
# What actually protects the data is the Row Level Security policy in
# supabase/schema.sql, enforced by Postgres. If RLS is disabled, this key alone is
# enough to read the whole table.
#
# NEVER put the service_role key in a REACT_APP_ variable. It bypasses RLS.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# --- Fallback passcode ----------------------------------------------------
#
# Only used when no Supabase project is configured, so that a fresh clone can
# still open the admin view. It is compared in the browser and ships in the
# bundle: it is a demo gate, not access control.
REACT_APP_ADMIN_PASSCODE=hpair-admin
